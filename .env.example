# Copy to .env and fill in. Placeholder values only -- no real credentials here.
#
# Reproducing the reported tables from the released trajectories needs none of
# this: analysis/summary_tables.py, analysis/grounding_checkers/analyze.py and
# experiments/compute_judge_agreement.py read files on disk. Credentials are
# required to re-run experiments/run.py, which calls a hosted model, and to
# re-run analysis/tau_curve.py, which re-embeds each query; the threshold sweep
# it reports is already in analysis/tau_curve_<cell>.json.

# --- Azure OpenAI: required to run experiments ------------------------------
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Backbone deployment. Note that on the long-context and RAG cells this, not
# run.py's --model flag, selects the answering model: those backbones read the
# deployment straight from the environment.
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# Auxiliary deployments. The sub model runs the hint extractor; the judge model
# scores correctness and is excluded from all token accounting.
AZURE_OPENAI_SUB_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_JUDGE_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Optional: open-weight G3 verifier --------------------------------------
# Setting HGC_GATE_LM routes the gate's support verifier to an OpenAI-compatible
# endpoint while the backbone stays on Azure (see the open-weight appendix).
# Any local server exposing that interface works; point the base URL at it.
# HGC_GATE_LM=gemma4:31b
# OLLAMA_CLOUD_BASE_URL=http://localhost:11434/v1
# OLLAMA_CLOUD_API_KEY=

# --- Optional: abstention classifier ensemble -------------------------------
# Only experiments/classify_abstention_llm.py uses these.
# ANTHROPIC_API_KEY=
# ANTHROPIC_SUB_MODEL=claude-haiku-4-5

# --- Optional: gate knobs ---------------------------------------------------
# Defaults live in src/hgc/factories.py; run.py exposes matching CLI flags.
# Set here only to change the default for every run.
# HGC_GATE_VARIANT=full                    # full | g1g2 (G3 off) | g1g3 (G2 off)
# HGC_CONTAMINATION_FRACTION=0.20
# HGC_CACHE_SIM_THRESHOLD=0.85
# HGC_TOP_K_HINTS=3
# HGC_VERIFIER_MAX_DOC_CHARS=2500
# HGC_VERIFIER_CONTAINMENT_MIN_CHARS=5
# HGC_STRICT_NO_HINT=0                     # 1 reroutes uncovered cache hits to fallback
